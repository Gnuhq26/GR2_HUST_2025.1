// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  // Connection URL moved to prisma.config.ts; configure the connection for Migrate and PrismaClient there.
  // See https://pris.ly/d/config-datasource and https://pris.ly/d/prisma7-client-config
}

model Store {
  StoreID Int @id @default(autoincrement())
  StoreName String @db.VarChar(255)
  Subdomain String @unique @db.VarChar(100)
  Phone String? @db.VarChar(20)
  Address String? @db.VarChar(500)
  Status String @default("Active") @db.VarChar(50)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)

  // Relations
  roles Role[]
  storeUsers StoreUser[]
  categories Category[]
  products Product[]
  suppliers Supplier[]
  inventories Inventory[]
  customers Customer[]
  orders Order[]
  stockReceipts StockReceipt[]
}

model Role {
  RoleID Int @id @default(autoincrement())
  StoreID Int
  RoleName String @db.VarChar(100)
  Description String? @db.VarChar(255)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store Store @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  storeUsers StoreUser[]
  rolePermissions RolePermission[]

  @@unique([StoreID, RoleName])
}

model Permission {
  PermissionID Int @id @default(autoincrement())
  Action String @db.VarChar(100)
  Subject String @db.VarChar(100)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  rolePermissions RolePermission[]

  @@unique([Action, Subject])
}

model RolePermission {
  RoleID Int
  PermissionID Int
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  role Role @relation(fields: [RoleID], references: [RoleID], onDelete: Cascade)
  permission Permission @relation(fields: [PermissionID], references: [PermissionID], onDelete: Cascade)

  @@id([RoleID, PermissionID])
}

model User {
  UserID Int @id @default(autoincrement())
  Email String @unique @db.VarChar(255)
  PasswordHash String @db.VarChar(255)
  FullName String? @db.VarChar(100)
  Phone String? @db.VarChar(20)
  Address String? @db.VarChar(255)
  CreatedAt DateTime @default(now()) @db.Timestamp(0)

  // Relations
  storeUsers StoreUser[]
  orders Order[]
}

model StoreUser {
  StoreID Int
  UserID Int
  RoleID Int
  CreatedAt DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store Store @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  user User @relation(fields: [UserID], references: [UserID], onDelete: Cascade)
  role Role @relation(fields: [RoleID], references: [RoleID], onDelete: Restrict)

  @@id([StoreID, UserID])
}

// ==========================================
// PHẦN NGHIỆP VỤ (BUSINESS LOGIC)
// ==========================================

model Category {
  CategoryID   Int      @id @default(autoincrement())
  StoreID      Int
  CategoryName String   @db.VarChar(255)
  Description  String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt    DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store     @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  products     Product[]

  @@unique([StoreID, CategoryName]) // Tránh trùng tên danh mục trong cùng 1 cửa hàng
}

model Product {
  ProductID   Int      @id @default(autoincrement())
  StoreID     Int
  CategoryID  Int
  ProductName String   @db.VarChar(255)
  SKU         String?  @db.VarChar(50) 
  BaseUnit    String   @db.VarChar(50) // Đơn vị gốc (ví dụ: Viên, Kg, Bao)
  Description String?  @db.Text
  IsActive    Boolean  @default(true)
  CreatedAt   DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt   DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store         @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  category     Category      @relation(fields: [CategoryID], references: [CategoryID], onDelete: Restrict)
  units        ProductUnit[]
  prices       PriceList[]
  inventories  Inventory[]
  stockReceiptDetails StockReceiptDetail[]
  orderDetails OrderDetail[]

  @@unique([StoreID, SKU]) // Mã hàng không được trùng trong cùng 1 cửa hàng
}

model ProductUnit {
  UnitID        Int     @id @default(autoincrement())
  ProductID     Int
  UnitName      String  @db.VarChar(50) // Ví dụ: Pallet, Xe, Thùng
  ExchangeValue Decimal @db.Decimal(18, 3) // Tỷ lệ quy đổi (ví dụ: 1 Pallet = 500.000 Viên)
  IsDefault     Boolean @default(false)

  // Relations
  product       Product @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)
}

model PriceList {
  PriceID      Int     @id @default(autoincrement())
  ProductID    Int
  PriceName    String  @db.VarChar(100) // Ví dụ: Giá thợ, Giá bán lẻ
  UnitPrice    Decimal @db.Decimal(18, 2)
  MinQuantity  Int     @default(0)

  // Relations
  product      Product @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)
}

// ==========================================
// KHO HÀNG VÀ NHẬP XUẤT (INVENTORY MANAGEMENT)
// ==========================================

// 1. Quản lý Nhà cung cấp
model Supplier {
  SupplierID   Int      @id @default(autoincrement())
  StoreID      Int
  SupplierName String   @db.VarChar(255)
  Phone        String?  @db.VarChar(20)
  Address      String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt    DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  receipts     StockReceipt[]

  @@unique([StoreID, SupplierName]) // Tránh trùng tên nhà cung cấp trong cùng 1 cửa hàng
}

// 2. Bảng Tồn kho thực tế (Inventory)
model Inventory {
  InventoryID  Int      @id @default(autoincrement())
  StoreID      Int
  ProductID    Int
  Quantity     Decimal  @db.Decimal(18, 2) @default(0) // Luôn lưu theo đơn vị gốc (BaseUnit)
  LastUpdated  DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  product      Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Cascade)

  @@unique([StoreID, ProductID]) // Mỗi sản phẩm trong một cửa hàng chỉ có 1 dòng tồn kho chính
}

// 3. Phiếu nhập kho
model StockReceipt {
  ReceiptID    Int      @id @default(autoincrement())
  StoreID      Int
  SupplierID   Int
  ImportDate   DateTime @default(now()) @db.Timestamp(0)
  TotalAmount  Decimal  @db.Decimal(18, 2)
  Note         String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  supplier     Supplier @relation(fields: [SupplierID], references: [SupplierID], onDelete: Restrict)
  details      StockReceiptDetail[]

  @@index([StoreID])
  @@index([SupplierID])
}

// 4. Chi tiết phiếu nhập
model StockReceiptDetail {
  DetailID     Int      @id @default(autoincrement())
  ReceiptID    Int
  ProductID    Int
  UnitName     String   @db.VarChar(50) // Đơn vị tính khi nhập (có thể khác BaseUnit)
  Quantity     Decimal  @db.Decimal(18, 2) // Số lượng nhập theo UnitName
  UnitPrice    Decimal  @db.Decimal(18, 2) // Giá nhập của đơn vị này

  // Relations
  receipt      StockReceipt @relation(fields: [ReceiptID], references: [ReceiptID], onDelete: Cascade)
  product      Product      @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)

  @@index([ReceiptID])
  @@index([ProductID])
}

// ==========================================
// BÁN HÀNG VÀ QUẢN LÝ ĐƠN HÀNG (SALES & ORDER MANAGEMENT) - GIAI ĐOẠN 9
// ==========================================

// 1. Quản lý Khách hàng
model Customer {
  CustomerID   Int      @id @default(autoincrement())
  StoreID      Int
  CustomerName String   @db.VarChar(255)
  Phone        String?  @db.VarChar(20)
  Address      String?  @db.Text
  CreatedAt    DateTime @default(now()) @db.Timestamp(0)
  UpdatedAt    DateTime @updatedAt @db.Timestamp(0)

  // Relations
  store        Store    @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  orders       Order[]

  @@index([StoreID])
}

// 2. Đơn hàng (Hóa đơn)
model Order {
  OrderID      Int      @id @default(autoincrement())
  StoreID      Int
  CustomerID   Int?     // Có thể bán cho khách vãng lai (null)
  UserID       Int      // Nhân viên thực hiện bán hàng
  OrderDate    DateTime @default(now()) @db.Timestamp(0)
  TotalAmount  Decimal  @db.Decimal(18, 2)
  Note         String?  @db.Text

  // Relations
  store        Store         @relation(fields: [StoreID], references: [StoreID], onDelete: Cascade)
  customer     Customer?     @relation(fields: [CustomerID], references: [CustomerID], onDelete: SetNull)
  user         User          @relation(fields: [UserID], references: [UserID], onDelete: Restrict)
  details      OrderDetail[]

  @@index([StoreID])
  @@index([CustomerID])
  @@index([UserID])
}

// 3. Chi tiết đơn hàng
model OrderDetail {
  DetailID     Int      @id @default(autoincrement())
  OrderID      Int
  ProductID    Int
  UnitName     String   @db.VarChar(50) // Đơn vị bán (Pallet, Thùng, Viên...)
  Quantity     Decimal  @db.Decimal(18, 2) // Số lượng bán theo UnitName
  UnitPrice    Decimal  @db.Decimal(18, 2) // Giá thực tế lúc chốt đơn
  
  // Relations
  order        Order    @relation(fields: [OrderID], references: [OrderID], onDelete: Cascade)
  product      Product  @relation(fields: [ProductID], references: [ProductID], onDelete: Restrict)

  @@index([OrderID])
  @@index([ProductID])
}